{$DOMAIN:vanceai.space} {
    encode zstd gzip

    reverse_proxy agent:8000 {
        flush_interval -1
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        -Server
    }
}

www.{$DOMAIN:vanceai.space} {
    redir https://{$DOMAIN:vanceai.space}{uri} permanent
}
