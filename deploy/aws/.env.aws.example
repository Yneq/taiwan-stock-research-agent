# Public hostname. Do not include https:// or a trailing slash.
DOMAIN=vanceai.space

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Java StockTracker database (Neon during the first migration stage)
# DB_URL must start with jdbc:postgresql:// and must not include DB_URL= twice.
DB_URL=jdbc:postgresql://YOUR_NEON_HOST/neondb?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=
FINMIND_TOKEN=

# Shared service secrets. The same value is injected into both containers.
AGENT_API_KEY=
JWT_SECRET=

# Server-only portfolio demo account
DEMO_USERNAME=finscope_demo
DEMO_EMAIL=demo@finscope.tw
DEMO_PASSWORD=

# Agent limits
MAX_AGENT_STEPS=3
REQUEST_TIMEOUT_SECONDS=60
SESSION_COOKIE_NAME=finscope_session
